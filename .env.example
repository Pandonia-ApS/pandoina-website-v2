# ---------------------------------------------------------------------------
# Pandonia — environment template
# Copy to .env.local for development.
# ---------------------------------------------------------------------------

# Canonical origin. Used for metadata, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL="https://www.pandonia.com"

# ---------------------------------------------------------------------------
# CLINICAL CONTENT GATE  —  see docs/clinical-content.md
# ---------------------------------------------------------------------------
# `npm run build` runs the clinical validator first and FAILS if any clinical
# field is still `placeholder` or `requires_review`.
#
# Set to "true" ONLY for internal preview deploys where unverified content is
# expected. Placeholders then render with the dotted review treatment.
# Never set this in the production environment.
PANDONIA_ALLOW_PLACEHOLDERS="false"

# ---------------------------------------------------------------------------
# BOOKING  —  integration boundary, see docs/README section "Backend"
# ---------------------------------------------------------------------------
# The booking flow currently hands off to a third-party scheduler.
# No booking is created by this codebase. See src/content/products.ts.
NEXT_PUBLIC_BOOKING_URL="https://system.easypractice.net/book/pandonia"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Privacy-respecting analytics endpoint. Leave empty to disable entirely.
NEXT_PUBLIC_ANALYTICS_URL=""
